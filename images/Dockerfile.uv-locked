# Build this recipe only from a verified checkout at the profile's head_commit.
# DiffMosaic never invokes Docker build; the resulting image identity is reviewed
# and recorded manually before a candidate becomes a study subject.

ARG PYTHON_IMAGE=python:3.11-slim
FROM ${PYTHON_IMAGE}

ARG APT_PACKAGES=""
ARG UV_GROUP

ENV VIRTUAL_ENV=/opt/diffmosaic-venv
ENV UV_PROJECT_ENVIRONMENT=/opt/diffmosaic-venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /workspace
COPY . /workspace

RUN if [ -n "${APT_PACKAGES}" ]; then \
        apt-get update \
        && apt-get install --no-install-recommends --yes ${APT_PACKAGES} \
        && rm -rf /var/lib/apt/lists/*; \
    fi \
    && test -n "${UV_GROUP}" \
    && python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir uv \
    && uv sync --locked --group "${UV_GROUP}"

CMD ["python", "-m", "pytest"]
